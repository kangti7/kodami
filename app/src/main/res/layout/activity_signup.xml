<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:id="@+id/btnTheme"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="end"
        android:background="@drawable/bg_theme_toggle_splash"
        android:contentDescription="Ganti tema"
        android:padding="10dp"
        app:tint="@color/theme_btn_tint"
        android:src="@drawable/ic_dark_mode" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:contentDescription="Logo Kodami"
            android:src="@drawable/ic_logo_kopi" />

        <TextView
            android:id="@+id/tvSignUpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:gravity="center_horizontal"
            android:text="Sign up"
            android:textColor="@color/splash_title"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSignUpSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_horizontal"
            android:textAlignment="center"
            android:text="Masuk untuk menikmati kopi dan camilan favoritmu setiap hari."
            android:textColor="@color/splash_tagline"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:minWidth="220dp"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:text="Register"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/caramel"
            app:cornerRadius="28dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:minWidth="220dp"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:text="Login"
            android:textColor="@color/splash_title"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:strokeColor="@color/caramel"
            app:strokeWidth="1.5dp" />
    </LinearLayout>
</LinearLayout>
