<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:id="@+id/btnTheme"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="end"
            android:background="@drawable/bg_theme_toggle_splash"
            android:contentDescription="Ganti tema"
            android:padding="10dp"
            app:tint="@color/theme_btn_tint"
            android:src="@drawable/ic_dark_mode" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:contentDescription="Logo Kodami"
            android:src="@drawable/ic_logo_kopi" />

        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_horizontal"
            android:text="Login User"
            android:textColor="@color/splash_title"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoginSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:gravity="center_horizontal"
            android:text="Masuk untuk mulai memesan"
            android:textColor="@color/splash_tagline"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/bg_input"
                android:hint="Username"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="@color/splash_title"
                android:textColorHint="@color/gray_text" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_input"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:paddingStart="16dp"
                    android:paddingEnd="52dp"
                    android:textColor="@color/splash_title"
                    android:textColorHint="@color/gray_text" />

                <ImageView
                    android:id="@+id/btnTogglePw"
                    android:layout_width="48dp"
                    android:layout_height="54dp"
                    android:layout_gravity="end"
                    android:contentDescription="Tampilkan atau sembunyikan password"
                    android:padding="13dp"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="@color/gray_text" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:minWidth="220dp"
                android:paddingStart="36dp"
                android:paddingEnd="36dp"
                android:text="Login"
                android:textColor="@color/ink"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/caramel"
                app:cornerRadius="28dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
